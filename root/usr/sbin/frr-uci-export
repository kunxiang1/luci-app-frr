#!/bin/sh
# frr-uci-export — render UCI config 'frr' into /etc/frr/{daemons,frr.conf} and reload.
# Single source of truth is UCI; hand edits to frr.conf are overwritten on save.
#   frr-uci-export           write files + reload/restart (stop if globally disabled)
#   frr-uci-export --stdout  print generated frr.conf (preview)
#   frr-uci-export --check   exit 0 iff installed files match what we would generate
CONFDIR=${CONFDIR:-/etc/frr}
DAEMONS=${DAEMONS:-$CONFDIR/daemons}
FFCONF=${FFCONF:-$CONFDIR/frr.conf}

g() { uci -q get "frr.$1"; }
on() { [ "$(g "$1")" = 1 ]; }
hasbin() { [ -x "${BINDIR:-/usr/sbin}/$1" ]; }   # skip config for daemons whose package isn't installed
gl() { g "$1" | tr ' ' '\n'; }          # list entries, one per line
secids() { uci -q show frr | sed -n "s/^frr\.\([^=.]*\)=${1}$/\1/p"; }
on_any() { [ -n "$(secids "$1")" ]; }   # any section of type exists

gen_daemons() {
	frr_on=$(on global.enabled && echo yes || echo no)
	d() { on "$1.enabled" && hasbin "$2" && [ "$frr_on" = yes ] && echo yes || echo no; }
	cat <<EOF
# generated by luci-app-frr from /etc/config/frr - do not edit
zebra=yes
mgmtd=yes
staticd=yes
bgpd=$(d bgp bgpd)
ospfd=$(d ospf ospfd)
ospf6d=$(d ospf6 ospf6d)
ripd=$(d rip ripd)
ripngd=$(d ripng ripngd)
isisd=$(d isis isisd)
eigrpd=$(d eigrp eigrpd)
babeld=$(d babel babeld)
pimd=$(d pim pimd)
pim6d=$(d pim6 pim6d)
ldpd=$(d ldp ldpd)
nhrpd=$(d nhrp nhrpd)
pathd=$( { on path.enabled || { [ "$(g sr.enabled)" = 1 ] && [ "$(g sr.mpls_te)" = 1 ]; }; } && hasbin pathd && [ "$frr_on" = yes ] && echo yes || echo no)
pbrd=$(d pbr pbrd)
fabricd=$(d fabric fabricd)
vrrpd=$([ "$frr_on" = yes ] && hasbin vrrpd && on_any vrrp && echo yes || echo no)
bfdd=$([ "$frr_on" = yes ] && hasbin bfdd && on_any bfd && echo yes || echo no)
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
mgmtd_options="  -A 127.0.0.1"
bgpd_options="   -A 127.0.0.1"
ospfd_options="  -A 127.0.0.1"
ospf6d_options=" -A ::1"
ripd_options="   -A 127.0.0.1"
ripngd_options=" -A ::1"
isisd_options="  -A 127.0.0.1"
eigrpd_options=" -A 127.0.0.1"
babeld_options=" -A 127.0.0.1"
pimd_options="   -A 127.0.0.1"
pim6d_options="  -A ::1"
ldpd_options="   -A 127.0.0.1"
nhrpd_options="  -A 127.0.0.1"
pathd_options="  -A 127.0.0.1"
pbrd_options="   -A 127.0.0.1"
fabricd_options=" -A 127.0.0.1"
vrrpd_options="  -A 127.0.0.1"
bfdd_options="   -A 127.0.0.1"
EOF
}

# "proto:metric:route-map" -> "redistribute proto [metric M] [route-map R]"
redir() {
	proto=${1%%:*}; rest=${1#*:}
	if [ "$rest" = "$1" ]; then metric=; rmap=
	else
		metric=${rest%%:*}; rmap=${rest#*:}
		[ "$rmap" = "$metric" ] && rmap=
	fi
	printf 'redistribute %s' "$proto"
	[ -n "$metric" ] && printf ' metric %s' "$metric"
	[ -n "$rmap" ] && printf ' route-map %s' "$rmap"
	printf '\n'
}

gen_bgp() {
	echo "!
router bgp $(g bgp.as)
 bgp router-id $(g bgp.router_id)
 no bgp ebgp-requires-policy"
	# FRR 10.x: keepalive/holdtime moved from global `timers` to per-neighbor;
	# ebgp-requires-policy defaults ON and silently drops all eBGP updates (verified on 10.4.1)
	[ -n "$(g bgp.distance_ebgp)" ] && echo " distance bgp $(g bgp.distance_ebgp) $(g bgp.distance_ibgp) $(g bgp.distance_local)"
	on bgp.gr && echo " graceful-restart
 graceful-restart period $(g bgp.gr_period)"
	[ -n "$(g bgp.maxpath_ebgp)" ] && echo " maximum-paths $(g bgp.maxpath_ebgp)"
	[ -n "$(g bgp.maxpath_ibgp)" ] && echo " maximum-paths ibgp $(g bgp.maxpath_ibgp)"
	for sid in $(secids bgp_neighbor); do
		n=$(uci -q get frr.$sid.address); r=$(uci -q get frr.$sid.remote_as)
		[ -n "$n" ] && [ -n "$r" ] || continue
		echo " neighbor $n remote-as $r"
		echo " neighbor $n timers $(g bgp.keepalive) $(g bgp.holdtime)"
		d=$(uci -q get frr.$sid.description); [ -n "$d" ] && echo " neighbor $n description $d"
		p=$(uci -q get frr.$sid.password);     [ -n "$p" ] && echo " neighbor $n password $p"
		u=$(uci -q get frr.$sid.update_source); [ -n "$u" ] && echo " neighbor $n update-source $u"
		m=$(uci -q get frr.$sid.ebgp_multihop); [ -n "$m" ] && echo " neighbor $n ebgp-multihop $m"
	done
	echo " address-family ipv4 unicast"
	for sid in $(secids bgp_neighbor); do
		n=$(uci -q get frr.$sid.address)
		case $n in *:*) continue;; esac
		[ "$(uci -q get frr.$sid.activate)" = 1 ] && echo "  neighbor $n activate"
		r=$(uci -q get frr.$sid.route_map_in);  [ -n "$r" ] && echo "  neighbor $n route-map $r in"
		r=$(uci -q get frr.$sid.route_map_out); [ -n "$r" ] && echo "  neighbor $n route-map $r out"
	done
	gl bgp.network4 | while read -r e; do [ -n "$e" ] && echo " network $e"; done
	gl bgp.redistribute4 | while read -r e; do [ -n "$e" ] && echo " $(redir "$e")"; done
	gen_agg 4
	echo " exit-address-family
 address-family ipv6 unicast"
	for sid in $(secids bgp_neighbor); do
		n=$(uci -q get frr.$sid.address)
		case $n in *:*) ;; *) continue;; esac
		[ "$(uci -q get frr.$sid.activate)" = 1 ] && echo "  neighbor $n activate"
	done
	gl bgp.network6 | while read -r e; do [ -n "$e" ] && echo " network $e"; done
	gl bgp.redistribute6 | while read -r e; do [ -n "$e" ] && echo " $(redir "$e")"; done
	gen_agg 6
	echo " exit-address-family"
}
gen_agg() { # $1 = 4|6
	for sid in $(secids bgp_aggregate); do
		[ "$(uci -q get frr.$sid.family)" = "$1" ] || continue
		p=$(uci -q get frr.$sid.prefix); [ -n "$p" ] || continue
		o=" aggregate-address $p"
		[ "$(uci -q get frr.$sid.as_set)" = 1 ] && o="$o as-set"
		[ "$(uci -q get frr.$sid.summary_only)" = 1 ] && o="$o summary-only"
		echo "$o"
	done
}

gen_ospf() {
	echo "!
router ospf"
	[ -n "$(g ospf.router_id)" ] && echo " router-id $(g ospf.router_id)"
	echo " timers throttle spf $(g ospf.spf_delay) $(g ospf.spf_hold) $(g ospf.spf_max)"
	d=""
	[ -n "$(g ospf.distance_intra)" ] && d="$d intra-area $(g ospf.distance_intra)"
	[ -n "$(g ospf.distance_inter)" ] && d="$d inter-area $(g ospf.distance_inter)"
	[ -n "$(g ospf.distance_external)" ] && d="$d external $(g ospf.distance_external)"
	[ -n "$d" ] && echo " distance ospf$d"
	on ospf.rfc1583 && echo " compatible rfc1583"
	[ -n "$(g ospf.maxpath)" ] && echo " maximum-paths $(g ospf.maxpath)"
	for sid in $(secids ospf_interface); do
		[ "$(uci -q get frr.$sid.passive)" = 1 ] && { i=$(uci -q get frr.$sid.ifname); [ -n "$i" ] && echo " passive-interface $i"; }
	done
	gl ospf.redistribute | while read -r e; do [ -n "$e" ] && echo " $(redir "$e")"; done
	[ "$(g ospf.default_originate)" = 1 ] && {
		o=" default-information originate"
		[ "$(g ospf.always)" = 1 ] && o="$o always"
		[ -n "$(g ospf.default_metric)" ] && o="$o metric $(g ospf.default_metric)"
		echo "$o"
	}
	for sid in $(secids ospf_area); do
		a=$(uci -q get frr.$sid.area); [ -n "$a" ] || continue
		t=$(uci -q get frr.$sid.type)
		case "$t" in
		stub) echo " area $a stub$([ "$(uci -q get frr.$sid.no_summary)" = 1 ] && echo ' no-summary')" ;;
		nssa) echo " area $a nssa$([ "$(uci -q get frr.$sid.no_summary)" = 1 ] && echo ' no-summary')" ;;
		esac
		v=$(uci -q get frr.$sid.virtual_link); [ -n "$v" ] && echo " area $a virtual-link $v"
	done
	for sid in $(secids ospf_network); do
		c=$(uci -q get frr.$sid.cidr); [ -n "$c" ] || continue
		echo " network $c area $(uci -q get frr.$sid.area)"
	done
}

gen_ospf6() {
	echo "!
router ospf6
 router-id $(g ospf6.router_id)"
	gl ospf6.redistribute | while read -r e; do [ -n "$e" ] && echo " $(redir "$e")"; done
	[ "$(g ospf6.always)" = 1 ] && echo " default-information originate always"
}

gen_rip() { # $1 = rip|ripng
	p=$1
	echo "!
router $p"
	[ "$p" = rip ] && echo " version $(g rip.version)"
	[ -n "$(g $p.distance)" ] && echo " distance $(g $p.distance)"
	[ "$p" = rip ] && [ -n "$(g rip.default_metric)" ] && echo " default-metric $(g rip.default_metric)"
	u=$(g $p.update_timer); t=$(g $p.timeout_timer); f=$(g $p.flush_timer)
	[ -n "$u$t$f" ] && echo " timers basic ${u:-30} ${t:-180} ${f:-120}"
	[ "$p" = rip ] && [ -n "$(g rip.maxpath)" ] && echo " maximum-paths $(g rip.maxpath)"
	gl $p.network | while read -r e; do [ -n "$e" ] && echo " network $e"; done
	[ "$p" = rip ] && gl rip.neighbor | while read -r e; do [ -n "$e" ] && echo " neighbor $e"; done
	# passive interfaces belong to the router node, not the interface block
	[ "$p" = rip ] && for sid in $(secids rip_interface); do
		[ "$(uci -q get frr.$sid.passive)" = 1 ] && { i=$(uci -q get frr.$sid.ifname); [ -n "$i" ] && echo " passive-interface $i"; }
	done
	gl $p.redistribute | while read -r e; do [ -n "$e" ] && echo " $(redir "$e")"; done
	[ "$(g $p.default_originate)" = 1 ] && echo " default-information originate"
}

# Segment-Routing (IS-IS part): `segment-routing ...` lines inside router isis.
gen_sr_isis() {
	[ "$(g sr.enabled)" = 1 ] || return 0
	echo " segment-routing on"
	if [ -n "$(g sr.gb_lower)" ] && [ -n "$(g sr.gb_upper)" ]; then
		l=" segment-routing global-block $(g sr.gb_lower) $(g sr.gb_upper)"
		[ -n "$(g sr.lb_lower)" ] && [ -n "$(g sr.lb_upper)" ] && l="$l local-block $(g sr.lb_lower) $(g sr.lb_upper)"
		echo "$l"
	fi
	[ -n "$(g sr.node_msd)" ] && echo " segment-routing node-msd $(g sr.node_msd)"
	for sid in $(secids sr_prefix); do
		p=$(uci -q get frr.$sid.prefix); [ -n "$p" ] || continue
		t=$(uci -q get frr.$sid.sid_type); v=$(uci -q get frr.$sid.sid_value)
		[ -n "$t" ] && [ -n "$v" ] || continue
		l=" segment-routing prefix $p"
		alg=$(uci -q get frr.$sid.algorithm); [ -n "$alg" ] && l="$l algorithm $alg"
		l="$l $t $v"
		[ "$(uci -q get frr.$sid.explicit_null)" = 1 ] && l="$l explicit-null"
		[ "$(uci -q get frr.$sid.no_php_flag)" = 1 ] && l="$l no-php-flag"
		[ "$(uci -q get frr.$sid.n_flag_clear)" = 1 ] && l="$l n-flag-clear"
		echo "$l"
	done
}

# Segment-Routing TE (pathd): top-level `segment-routing` -> `traffic-eng`.
gen_sr_te() {
	[ "$(g sr.enabled)" = 1 ] || return 0
	[ "$(g sr.mpls_te)" = 1 ] || return 0
	echo "!
segment-routing
 traffic-eng
  mpls-te on"
	imp=$(g sr.ted_import); [ -n "$imp" ] && echo "  mpls-te import $imp"
	for sl in $(secids sr_seglist); do
		n=$(uci -q get frr.$sl.name); [ -n "$n" ] || continue
		echo "  segment-list $n"
		uci -q show "frr.$sl.entry" 2>/dev/null | sed -E "s/^[^=]+=//; s/ ?'([^']*)'/\n\1/g" | sed '/^[[:space:]]*$/d' | sed 's/^/   /'
		echo "  !"
	done
	for po in $(secids sr_policy); do
		c=$(uci -q get frr.$po.color); e=$(uci -q get frr.$po.endpoint)
		[ -n "$c" ] && [ -n "$e" ] || continue
		echo "  policy color $c endpoint $e"
		nm=$(uci -q get frr.$po.name); [ -n "$nm" ] && echo "   name $nm"
		bs=$(uci -q get frr.$po.binding_sid); [ -n "$bs" ] && echo "   binding-sid $bs"
		uci -q show "frr.$po.candidate" 2>/dev/null | sed -E "s/^[^=]+=//; s/ ?'([^']*)'/\n\1/g" | sed '/^[[:space:]]*$/d' | sed 's/^/   /'
		echo "  !"
	done
	echo " !"
}

gen_isis() {
	echo "!
router isis $(g isis.name)"
	gl isis.net | while read -r e; do [ -n "$e" ] && echo " net $e"; done
	[ -n "$(g isis.is_type)" ] && echo " is-type $(g isis.is_type)"
	[ -n "$(g isis.metric_style)" ] && echo " metric-style $(g isis.metric_style)"
	gen_sr_isis
	gl isis.redistribute | while read -r e; do [ -n "$e" ] && echo " $(redir "$e")"; done
}

gen_eigrp() {
	echo "!
router eigrp $(g eigrp.name)"
	gl eigrp.network | while read -r e; do [ -n "$e" ] && echo " network $e"; done
	gl eigrp.passive_interface | while read -r e; do [ -n "$e" ] && echo " passive-interface $e"; done
	[ -n "$(g eigrp.distance)" ] && echo " distance $(g eigrp.distance)"
	[ -n "$(g eigrp.variance)" ] && echo " variance $(g eigrp.variance)"
}

gen_babel() {
	echo "!
router babel"
	gl babel.network | while read -r e; do [ -n "$e" ] && echo " network $e"; done
	# babel: redistribute <ipv4|ipv6> <proto> [metric N]
	gl babel.redistribute | while read -r e; do
		af=${e%%:*}; rest=${e#*:}
		proto=${rest%%:*}; m=${rest#*:}
		[ "$m" = "$rest" ] && m=
		[ -n "$af" ] || continue
		printf ' redistribute %s %s' "$af" "$proto"
		[ -n "$m" ] && printf ' metric %s' "$m"
		printf '\n'
	done
}

gen_pim() { # $1 = pim|pim6
	echo "!
router $1"
	gl $1.rp_address | while read -r e; do [ -n "$e" ] && echo " rp-address $e"; done
}

gen_ldp() {
	echo "!
mpls ldp
 router-id $(g ldp.router_id)"
	ta=$(g ldp.transport_address)
	if [ -n "$ta" ]; then
		echo " address-family ipv4"
		echo "  discovery transport-address $ta"
		gl ldp.interfaces | while read -r e; do [ -n "$e" ] && echo "  interface $e"; done
		echo " exit-address-family"
	fi
}

gen_vrrp() {
	for sid in $(secids vrrp); do
		i=$(uci -q get frr.$sid.ifname); v=$(uci -q get frr.$sid.vrid)
		[ -n "$i" ] && [ -n "$v" ] || continue
		echo "!
interface $i"
		[ "$(uci -q get frr.$sid.version)" = 3 ] && echo " vrrp $v version 3"
		echo " vrrp $v priority $(uci -q get frr.$sid.priority)"
		a=$(uci -q get frr.$sid.addr); [ -n "$a" ] && echo " vrrp $v ip $a"
		ai=$(uci -q get frr.$sid.advertise_interval); [ -n "$ai" ] && echo " vrrp $v advertisement-interval $ai"
		[ "$(uci -q get frr.$sid.preempt)" = 1 ] && echo " vrrp $v preempt"
		[ "$(uci -q get frr.$sid.shutdown)" = 1 ] && echo " vrrp $v shutdown"
	done
}

gen_bfd() {
	for sid in $(secids bfd); do
		p=$(uci -q get frr.$sid.peer); [ -n "$p" ] || continue
		echo "!
peer $p"
		l=$(uci -q get frr.$sid.localaddr); [ -n "$l" ] && echo " local-address $l"
		ifc=$(uci -q get frr.$sid.interface); [ -n "$ifc" ] && echo " interface $ifc"
		m=$(uci -q get frr.$sid.multiplier); [ -n "$m" ] && echo " detect multiplier $m"
		tx=$(uci -q get frr.$sid.min_tx); [ -n "$tx" ] && echo " desired min tx interval $tx"
		rx=$(uci -q get frr.$sid.min_rx); [ -n "$rx" ] && echo " required min rx interval $rx"
		[ "$(uci -q get frr.$sid.enabled)" = 0 ] && echo " shutdown"
	done
}

# raw sections: free-form vtysh lines (covers nhrp/path/pbr/fabric + anything unsupported).
# lines is a uci list; each element is one config line (leading spaces = indent preserved).
gen_raw() {
	for sid in $(secids raw); do
		[ "$(uci -q get frr.$sid.enabled)" = 1 ] || continue
		echo "!"
		uci -q show "frr.$sid.lines" 2>/dev/null | sed -E "s/^[^=]+=//; s/ ?'([^']*)'/\n\1/g" | sed '/^[[:space:]]*$/d'
	done
}

gen_ifaces() {
	on ospf.enabled && hasbin ospfd && for sid in $(secids ospf_interface); do
		i=$(uci -q get frr.$sid.ifname); [ -n "$i" ] || continue
		body=""
		c=$(uci -q get frr.$sid.cost);          [ -n "$c" ] && body="$body
 ip ospf cost $c"
		nt=$(uci -q get frr.$sid.network_type); [ -n "$nt" ] && body="$body
 ip ospf network $nt"
		case "$(uci -q get frr.$sid.auth)" in
		simple) body="$body
 ip ospf authentication
 ip ospf authentication-key $(uci -q get frr.$sid.auth_key)" ;;
		md5) body="$body
 ip ospf authentication message-digest
 ip ospf message-digest-key 1 md5 $(uci -q get frr.$sid.auth_key)" ;;
		esac
		[ -n "$body" ] && printf '!
interface %s%s\n' "$i" "$body"
	done
	on rip.enabled && hasbin ripd && for sid in $(secids rip_interface); do
		i=$(uci -q get frr.$sid.ifname); [ -n "$i" ] || continue
		k=$(uci -q get frr.$sid.auth_key)
		case "$(uci -q get frr.$sid.auth_mode)" in
		text) [ -n "$k" ] && echo "!
interface $i
 ip rip authentication mode text
 ip rip authentication text-password $k" ;;
		md5) echo "!
interface $i
 ip rip authentication mode md5" ;;
		esac
	done
	on isis.enabled && hasbin isisd && for sid in $(secids isis_interface); do
		i=$(uci -q get frr.$sid.ifname); a=$(uci -q get frr.$sid.area_tag); [ -n "$i" ] && [ -n "$a" ] || continue
		echo "!
interface $i
 ip router isis $a"
		[ "$(uci -q get frr.$sid.p2p)" = 1 ] && echo " isis network point-to-point"
		ct=$(uci -q get frr.$sid.circuit_type); [ -n "$ct" ] && echo " isis circuit-type $ct"
	done
	on pim.enabled && hasbin pimd && for sid in $(secids pim_interface); do
		i=$(uci -q get frr.$sid.ifname); [ -n "$i" ] || continue
		body=""
		[ "$(uci -q get frr.$sid.pim)" = 1 ] && body="$body
 ip pim"
		[ "$(uci -q get frr.$sid.igmp)" = 1 ] && body="$body
 ip igmp"
		[ -n "$body" ] && printf '!
interface %s%s\n' "$i" "$body"
	done
	on babel.enabled && hasbin babeld && for sid in $(secids babel_interface); do
		i=$(uci -q get frr.$sid.ifname); [ -n "$i" ] || continue
		t=$(uci -q get frr.$sid.type); [ -n "$t" ] && echo "!
interface $i
 babel $t"
	done
}

render() {
	echo "! generated by luci-app-frr from /etc/config/frr - do not edit"
	echo "hostname $(g global.hostname)"
	echo "log syslog $(g global.log_level)"
	echo "service integrated-vtysh-config"
	on bgp.enabled && hasbin bgpd && [ -n "$(g bgp.as)" ] && gen_bgp
	on ospf.enabled && hasbin ospfd && gen_ospf
	on ospf6.enabled && hasbin ospf6d && gen_ospf6
	on rip.enabled && hasbin ripd && gen_rip rip
	on ripng.enabled && hasbin ripngd && gen_rip ripng
	on isis.enabled && hasbin isisd && gen_isis
	on eigrp.enabled && hasbin eigrpd && gen_eigrp
	on babel.enabled && hasbin babeld && gen_babel
	on pim.enabled && hasbin pimd && gen_pim pim
	on pim6.enabled && hasbin pim6d && gen_pim pim6
	on ldp.enabled && hasbin ldpd && gen_ldp
	on global.enabled && { on_any vrrp && hasbin vrrpd && gen_vrrp; on_any bfd && hasbin bfdd && gen_bfd; }
	on sr.enabled && hasbin pathd && gen_sr_te
	gen_raw
	gen_ifaces
	echo "!
line vty
!"
}

case "$1" in
--stdout) render; exit 0 ;;
--check)
	t=$(mktemp); render >"$t"
	cmp -s "$t" "$FFCONF" || { rm -f "$t"; exit 1; }
	gen_daemons | cmp -s - "$DAEMONS" || { rm -f "$t"; exit 1; }
	rm -f "$t"; exit 0
	;;
esac

tc=$(mktemp); td=$(mktemp)
render >"$tc"; gen_daemons >"$td"
changed=0
cmp -s "$tc" "$FFCONF" || changed=1
cmp -s "$td" "$DAEMONS" || changed=1
if [ "$changed" = 1 ]; then
	cat "$tc" > "$FFCONF"; chmod 0600 "$FFCONF"
	cat "$td" > "$DAEMONS"; chmod 0644 "$DAEMONS"
fi
rm -f "$tc" "$td"

if ! on global.enabled; then
	service frr stop 2>/dev/null
	exit 0
fi
[ "$changed" = 1 ] || exit 0
# ponytail: always restart — init's reload() races watchfrr restart with frr-reload and
# can leave daemons dead (observed 10.4.1). Upgrade: vtysh-write + frr-reload when flaps matter.
service frr restart
